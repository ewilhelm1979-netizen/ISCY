DATABASE_URL_FILE=/run/secrets/database_url
RUST_BACKEND_BIND=0.0.0.0:9000
RUST_BACKEND_URL=http://app:9000
ISCY_MEDIA_ROOT=/app/media
ISCY_APP_MODE=production
ISCY_TRUST_PROXY_IDENTITY_HEADERS=0
ISCY_TRUSTED_PROXY_CONFIGURED=1
ISCY_SECURE_COOKIES=1
# Set both values to 1 only when HTTPS is really terminated in front of ISCY.
ISCY_HTTPS_CONFIRMED=0
ISCY_HSTS_ENABLED=0
ISCY_SECRETS_DIR=./.runtime/secrets
ISCY_ALERTMANAGER_TOKEN_FILE=/run/secrets/iscy_alertmanager_token
ISCY_ALERTMANAGER_HMAC_SECRET_FILE=/run/secrets/iscy_alertmanager_hmac_secret
ISCY_ALERTMANAGER_HMAC_PREVIOUS_SECRET=
ISCY_ALERTMANAGER_HMAC_PREVIOUS_SECRET_FILE=
ISCY_ALERTMANAGER_HMAC_MAX_AGE_SECONDS=300
ISCY_ALERTMANAGER_TENANT_ID=
ISCY_ALERTMANAGER_USER_ID=
ISCY_INITIAL_ADMIN_TENANT_NAME=ISCY Production Tenant
ISCY_INITIAL_ADMIN_TENANT_SLUG=iscy-production
ISCY_INITIAL_ADMIN_USERNAME=iscy-admin
ISCY_INITIAL_ADMIN_EMAIL=iscy-admin@example.local
ISCY_INITIAL_ADMIN_FIRST_NAME=ISCY
ISCY_INITIAL_ADMIN_LAST_NAME=Admin
ISCY_INITIAL_ADMIN_PASSWORD_FILE=/run/secrets/iscy_initial_admin_password

POSTGRES_DB=isms
POSTGRES_USER=isms
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

NGINX_HOST=localhost
NGINX_CLIENT_MAX_BODY_SIZE=50m
NGINX_PROXY_READ_TIMEOUT=300

NVD_API_BASE_URL=https://services.nvd.nist.gov
NVD_API_KEY_FILE=/run/secrets/nvd_api_key

LOCAL_LLM_MODEL_NAME=iscy-rust-llm
LOCAL_LLM_N_CTX=8192
LOCAL_LLM_N_THREADS=8
LOCAL_LLM_GPU_LAYERS=0
ISCY_EVIDENCE_OBJECT_STORAGE_ACCESS_KEY_FILE=/run/secrets/iscy_s3_access_key
ISCY_EVIDENCE_OBJECT_STORAGE_SECRET_KEY_FILE=/run/secrets/iscy_s3_secret_key
ISCY_SECRET_ROOTS=/run/secrets
ISCY_EVIDENCE_SECRET_ROOTS=/run/secrets
